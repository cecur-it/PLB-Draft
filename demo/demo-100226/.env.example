# CS3 / CECUR-IT Unified SOC Console — environment template.
# Copy to .env (gitignored) for local `npm run dev`. For Docker / cloud /
# onprem / airgap installs, use `node cs3-launcher.mjs --profile <profile>`
# from the repository root instead; it generates .env from onboarding/env.*.template.
# NEVER commit real keys here.

# The console never generates demo, mock or simulated telemetry. CS3_DEMO_MODE=true is rejected at startup.
# Asset inventory (default: ../../PLB_Assets.csv relative to the working directory)
# PLB_ASSETS_CSV="/path/to/PLB_Assets.csv"
# Seconds without a keepalive before an enrolled agent is reported disconnected (default 300)
# CS3_AGENT_STALE_SECONDS="300"
# Scan job expiry in minutes: unclaimed queued jobs / claimed jobs with no result
# CS3_SCAN_QUEUED_TTL_MINUTES, CS3_SCAN_RUNNING_TTL_MINUTES

# Server listen port (default 3000). Direct development trusts no forwarded headers.
PORT="3000"
CS3_TRUST_PROXY_HOPS="0"

# Inference gateway (OpenAI-compatible: LiteLLM/vLLM). Cloud profile only; onprem/airgap use local Ollama.
INFERENCE_GATEWAY_URL=""
# Optional bearer token for the gateway (set via secret store, never commit).
INFERENCE_GATEWAY_KEY=""
# Model per role (versioned config, not product names). Default to OLLAMA_PRIMARY_MODEL / OLLAMA_FALLBACK_MODEL.
INFERENCE_MODEL_TRIAGE=""
INFERENCE_MODEL_FORENSIC=""
# Security tier (Errow primary + vulnerability analysis). Defaults to OLLAMA_SECURITY_MODEL server-side.
INFERENCE_MODEL_SECURITY=""
# Total inference deadline, including retries (default 60000 ms).
INFERENCE_TIMEOUT_MS="60000"
# Durable remediation jobs only (1000-7200000 ms); one attempt, maximum 4096 completion tokens.
INFERENCE_REMEDIATION_TIMEOUT_MS="3600000"
# Ollama structured JSON requests default to no hidden reasoning.
INFERENCE_REASONING_EFFORT="none"

# APP_URL: URL where this console is hosted (self links, OAuth callbacks).
APP_URL="http://localhost:3000"

# JWT_SECRET: signs auth tokens. Generate with: openssl rand -hex 32
JWT_SECRET=""

# FIREBASE (optional). Configure explicitly on cloud and onprem; airgap never uses Firebase.
FIREBASE_API_KEY=""
VITE_FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""
VITE_FIREBASE_PROJECT_ID=""
FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_AUTH_DOMAIN=""
FIREBASE_DATABASE_ID=""
VITE_FIREBASE_DATABASE_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_APP_ID=""
FIREBASE_MESSAGING_SENDER_ID=""

# errow server (optional live connector)
ERROW_BASE_URL="http://127.0.0.1:8088"
ERROW_API_KEY=""
# embedded = local errow-agent runner (onprem/airgap); remote = hosted API (cloud)
ERROW_MODE="embedded"
ERROW_SANDBOX_RUNTIME="docker"

# Cecur open-source SIEM & XDR (optional external indexer)
CECUR_INDEXER_URL="https://127.0.0.1:9200"
CECUR_CLUSTER_NAME="cecur-prod-cluster"

# Durable log indexing: off by default (events stay in the 300-row in-memory hot
# cache). Set "true" once an OpenSearch/Wazuh Indexer is running and reachable at
# CECUR_INDEXER_URL (deployment/operations/opensearch-cluster.md, on-prem/).
CS3_INDEXER_ENABLED="false"
CECUR_INDEXER_USERNAME="admin"
CECUR_INDEXER_PASSWORD=""
CECUR_INDEXER_TLS_INSECURE="false"

# --- Audit ledger ---
# CS3_AUDIT_STRICT: "1" answers 503 when a critical action (containment, alert
# triage, incident update, auth) cannot be written to the durable audit ledger,
# so no unrecorded action is reported as successful. Requires PostgreSQL.
CS3_AUDIT_STRICT="0"
# CS3_AUDIT_PERSIST_TIMEOUT_MS: how long a critical action waits for the ledger
# before answering. The write keeps retrying in the background either way.
CS3_AUDIT_PERSIST_TIMEOUT_MS="2000"
# CS3_AUDIT_QUEUE_MAX: entries queued while the ledger is unreachable before the
# oldest are dropped (and counted in /api/audit/verify-ledger).
CS3_AUDIT_QUEUE_MAX="5000"
# CS3_AUDIT_BACKLOG_ALERT: pending-append depth that raises cs3_audit_persist_backlog.
CS3_AUDIT_BACKLOG_ALERT="50"
# CS3_AUDIT_REPAIR: "1" re-anchors the in-memory chain to the persisted head when
# the persisted chain is found broken at boot (otherwise it only reports).
CS3_AUDIT_REPAIR="0"
# CS3_AUDIT_VERIFY_INTERVAL_MS: re-verify the persisted chain on this interval (0 disables); a
# break fails the health probe until the process restarts.
CS3_AUDIT_VERIFY_INTERVAL_MS="300000"
# Audit checkpoint anchor (scripts/audit-checkpoint.mjs). Mint once with --keygen.
CS3_AUDIT_CHECKPOINT_KEY=""
CS3_AUDIT_DSN=""
# CS3_ALERT_DEDUP_WINDOW_S: seconds during which a manager alert with the same rule, device and locator is
# folded into the existing alert (count incremented, severity raised if higher) instead of creating a new one.
# 0 disables deduplication. Bounds the retry window too: a Fluent Bit replay inside the window is a no-op.
CS3_ALERT_DEDUP_WINDOW_S="300"
# CS3_INGEST_MAX_BATCH: also caps POST /api/cecur/manager/alerts (413 above it).
