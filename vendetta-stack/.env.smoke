# Traces: PROMPT §1 Tier 3 (smoke); CONTRACT §1 (image pins), §8 (three legs), §11 (smoke runner)
#
# Self-contained environment for the end-to-end smoke test: .env.example plus the smoke overrides marked "smoke:" below.
# It is complete on its own, so compose needs no other env file:
#
#   docker compose --env-file .env.smoke --profile mock-llm --profile test up -d --build --wait
#
# The Console and SIEM legs go to the in-network sink stub (tests/stubs/sink.py) over plain HTTP. The ESOC leg stays disabled:
# it is OTLP/gRPC and the sink is an HTTP stub, so it cannot satisfy it. The two leg credentials are test literals that only
# the sink (which ignores authentication) ever receives; real deployments use *_FILE paths. Live scans, live feedback actions
# and cloud reachability are off. The image pins below must stay identical to .env.example.

FLUENT_BIT_IMAGE=fluent/fluent-bit:3.2.10-debug@sha256:ddc7932ed69e1e7bc34a62c57525c49f3947dc5fcee8b92256a33ae1836f3cda
FLUENT_BIT_DISTROLESS_IMAGE=fluent/fluent-bit:3.2.10@sha256:d6dec000c4929a439562525728c708f6e99800d7ddc82efd6aa4f45f3a20b562
FLUENTD_BASE_IMAGE=fluent/fluentd:v1.17-debian-1@sha256:d6114e87fb46d67fef988014cfeb9025df5d48984063dfde94c74cf4a1857440
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.17.1@sha256:1193b7c29c5d63028523728243cc4da047ac49f697a8f8105e5aeee2f89bcc4c
DASHBOARDS_IMAGE=opensearchproject/opensearch-dashboards:2.17.1@sha256:dc12b6f576aae6024780c01b3cc81abdf611d34340371980ef8edc7738479b8f
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1@sha256:2659f4c2ebb718e7695cb9b25ffa7d6be64db013daba13e05c875451cf51b0d3
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0@sha256:e13b6ed5cb929eeaee733479dce55e10eb3bc2e9c4586c705a4e8da41e5eacf5
GRAFANA_IMAGE=grafana/grafana:10.4.19@sha256:a9043254ba16fb10945cc27333963dfd08eccbb43b51f1222d831cc564e3a1f4
HAPROXY_IMAGE=haproxy:3.0-alpine@sha256:d2b3567d836f3b7d174edb6d6f611ed5308e7966e53a9cd9a597e0415a298efd
NGINX_IMAGE=nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
OLLAMA_IMAGE=ollama/ollama:0.40.5@sha256:5d3a2f25f9825628daba94dc0b1d421c7d57d6c03ae5faa9ba050e058bab8241
DIND_IMAGE=docker:27-dind@sha256:aa3df78ecf320f5fafdce71c659f1629e96e9de0968305fe1de670e0ca9176ce
BUSYBOX_IMAGE=busybox:1.37@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec
CURL_IMAGE=curlimages/curl:8.10.1@sha256:d9b4541e214bcd85196d6e92e2753ac6d0ea699f0af5741f8c6cccbfcf00ef4b
VENDETTA_MANAGER_IMAGE=wazuh/wazuh-manager:4.9.2@sha256:b906ebfc77d78446e9b676e1a0b3cd78e2bf3ac2341688f1726b09c29e0aa826

COMPOSE_PROJECT_NAME=vendetta-stack
STACK_VERSION=1.0.0
OLLAMA_PINNED_VERSION=0.40.5
LLAMA_CPP_PINNED_TAG=b4000
CS3_PROFILE=cloud
CS3_LLM_MODE=local
CS3_MESSAGE_MAX_CHARS=8000
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
STACK_KEY_GID=10001
VENDETTA_LOGS_GID=999

OPENSEARCH_BIND=127.0.0.1
OPENSEARCH_PORT=9200
DASHBOARDS_BIND=127.0.0.1
DASHBOARDS_PORT=5601
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
ALERTMANAGER_BIND=127.0.0.1
ALERTMANAGER_PORT=9093
FLUENT_BIND=127.0.0.1
FLUENT_BIT_FORWARD_PORT=24224
FLUENT_BIT_HTTP_PORT=9880
FLUENT_BIT_METRICS_PORT=2020
GATEWAY_BIND=127.0.0.1
GATEWAY_PUBLISH_PORT=9101
ERROW_VIEWER_BIND=127.0.0.1
ERROW_VIEWER_PUBLISH_PORT=8765
VENDETTA_BIND=127.0.0.1
VENDETTA_EVENTS_PORT=1514
VENDETTA_AUTHD_PORT=1515
VENDETTA_API_PORT=55000

OPENSEARCH_CONFIG_FILE=opensearch.single-node.yml
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"
OPENSEARCH_MEM_LIMIT=1536m
OPENSEARCH_CLUSTER_NAME=vendetta-stack
OPENSEARCH_MEMORY_LOCK=true
OPENSEARCH_EXPECTED_NODES=1
OPENSEARCH_APPLY_REPLICAS=auto
OPENSEARCH_WAIT_TIMEOUT=300
OPENSEARCH_USER=admin
NODE_BOX_TYPE=hot
OPENSEARCH_URL=https://localhost:9200

FLB_LOG_LEVEL=info
FLB_FORWARD_TLS=on
FLB_FORWARD_TLS_VERIFY=on
FLB_FORWARD_STORAGE_LIMIT=2G
CS3_EPS_LIMIT=500
CS3_LEGS_DIR=./secrets/cs3-legs
ERROW_TUI_PORT=24225
CFGAUDIT_ENABLED=false
CFGAUDIT_REPORTS_DIR=./data/cfgaudit
# smoke: Console and SIEM legs deliver to the sink stub; ESOC stays off (gRPC).
CS3_CONSOLE_ENABLED=true
CS3_HOST=sink
CS3_PORT=8080
CS3_TLS=Off
CS3_INGEST_KEY=smoke-console-ingest-key
CS3_ESOC_ENABLED=false
CS3_ESOC_HOST=localhost
CS3_ESOC_PORT=4317
CS3_ESOC_GRPC=On
CS3_ESOC_TLS=On
CS3_SIEM_ENABLED=true
CS3_SIEM_HOST=sink
CS3_SIEM_PORT=8080
CS3_SIEM_URI=/siem
CS3_SIEM_TLS=Off
CS3_SIEM_FORMAT=json_lines
CS3_SIEM_AUTH_SCHEME=Bearer
CS3_SIEM_TOKEN=smoke-siem-token

FLUENTD_LOG_LEVEL=info
FLUENTD_WORKERS=1
FLUENTD_OS_BUFFER_LIMIT=2GB
LLM_TRIAGE_VENDETTA_SEVERITY_REGEX='^(medium|high|critical)$'
LLM_TRIAGE_ERROW_SEVERITY_REGEX='^$'
ERROW_FEEDBACK_SEVERITY_REGEX='^critical$'
VENDETTA_EXECD_AGENT_REGEX='^$'
ERROW_FEEDBACK_AR_COMMAND='!host-isolate.sh'
VENDETTA_API_USER=wazuh-wui

OLLAMA_BIND_ADDR=127.0.0.1:11434
OLLAMA_PRIMARY_MODEL=nemotron-3-nano:30b
OLLAMA_FALLBACK_MODEL=gemma4:26b
OLLAMA_SECURITY_MODEL=nemotron-3-nano:30b
INFERENCE_MODEL_TRIAGE=nemotron-3-nano:30b
INFERENCE_MODEL_FORENSIC=gemma4:26b
INFERENCE_MODEL_SECURITY=nemotron-3-nano:30b
INFERENCE_MODEL_ERROW_SECURITY=nemotron-3-nano:30b
INFERENCE_MODEL_REASONING_DEEP=gemma4:31b
INFERENCE_TIMEOUT_MS=60000
INFERENCE_GPU_SHARE=1.0
GATEWAY_MTLS=optional
GATEWAY_MAX_CONCURRENCY=4
GATEWAY_MAX_QUEUE=512
GATEWAY_LOG_LEVEL=INFO
OLLAMA_LB_HAPROXY_REPLICAS=1
OLLAMA_LB_NGINX_REPLICAS=1
ENROLL_GATEWAY_URL=https://localhost:9101
MCP_LIVE=false
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=30m
OLLAMA_PRELOAD_MODELS=nemotron-3-nano:30b,gemma4:26b,gemma4:31b
OLLAMA_PRELOAD_STRICT=true
OLLAMA_READY_TIMEOUT=120
OLLAMA_START_PERIOD=600s
OLLAMA_MEM_LIMIT=32g
OLLAMA_GPU_COUNT=all
OLLAMA_AIRGAP_BUNDLE_DIR=/bundle
OLLAMA_BUNDLE_HOST_DIR=./dist/bundle/ollama
MOCK_LATENCY_MS=0
MOCK_TOOL_TARGET=scan-target.vendetta.lab

# Single source of truth for the Errow target allow-lists: comma list of host globs ("*.suffix" ok). ERROW_ALLOWED_TARGETS
# (errow entrypoint) and ERROW_FEEDBACK_ALLOWED_TARGETS (feedback loop) default from it; a non-empty per-service value wins.
# The errow-mcp/llm-gateway list is a yaml (MCP_TARGETS_FILE, additive over errow/mcp/policy.yaml) and must be extended by hand
# for real targets: scripts/check-allowlists.sh reports any drift between the three.
ERROW_TARGETS=scan-target.vendetta.lab
# ERROW_ALLOWED_TARGETS=
ERROW_SANDBOX_IMAGE=vendetta-stack/errow-sandbox:1.0.0
ERROW_BUNDLE_DIR=./dist/bundle/errow
ERROW_SANDBOX_IMAGE_TAR=/bundle/errow-sandbox.tar
ERROW_TELEMETRY=false
ERROW_CLOUD_ENABLED=false
ERROW_CLOUD_URL=https://app.errow.ai
ERROW_FEEDBACK_LIVE=false
ERROW_FEEDBACK_FORENSIC=true
# ERROW_FEEDBACK_ALLOWED_TARGETS=
ERROW_FEEDBACK_APPROVAL_DIR=./secrets/approval
MCP_ALLOWED_CLIENTS=llm-gateway,errow,errow-mcp
MCP_SANDBOX_NETWORK=offensive
MCP_TARGETS_DIR=./errow/config
ERROW_FEEDBACK_POLL_INTERVAL=60
SHIPPER_INTERVAL=10

PROMETHEUS_RETENTION=15d

# smoke: wait budget for tests/validate-pipeline.py.
PIPELINE_WAIT_SECONDS=120
