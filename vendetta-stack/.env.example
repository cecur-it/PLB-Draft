# Traces: PROMPT §1 (tiers), §2.5 (pinned artefacts); CONTRACT §1 (image pins), §2 (ports, names, volumes), §8 (legs), §11 (RUNTIME)
#
# Compose environment for the vendetta-stack. scripts/bootstrap.sh renders this file to .env (mode 0600, git-ignored);
# compose reads .env automatically. Everything here is a safe default: no secret values (passwords and tokens live in
# secrets/, certificates in pki/), nothing public-facing (every published port binds 127.0.0.1), local-only inference.
# Values containing spaces or regex characters are quoted. In-network service URLs (https://opensearch:9200 ...) are
# written into docker-compose.yml itself, so the host-side URLs below (OPENSEARCH_URL ...) are what scripts/*.sh use.
#
# Optional settings, unset by default (set them in .env only when needed; compose passes them through when present):
#   CS3_INGEST_KEY_FILE, CS3_SIEM_TOKEN_FILE  Fluent Bit leg credentials (path inside the container, e.g. /run/cs3-legs/ingest_key
#                                             with the file at secrets/cs3-legs/ingest_key); never put the value itself here.
#   CS3_AGGREGATOR_LEGS (esoc,siem), CS3_ESOC_URL, CS3_ESOC_TOKEN_FILE, CS3_SIEM_URL   Fluentd-side ESOC/SIEM legs; never enable the
#                                             same leg in Fluent Bit and Fluentd.
#   MCP_TARGETS_FILE                          extra scan targets (/etc/vendetta/mcp/<file>, host dir MCP_TARGETS_DIR) for gateway + errow-mcp.
#   MOCK_DOWN_MODELS                          comma list of model tags the mock Ollama answers with HTTP 503.
#   PIPELINE_WAIT_SECONDS                     smoke-runner wait budget (tests/validate-pipeline.py).
#
# Switching the Ollama load balancer: HAProxy (ollama-lb) is the default. To use NGINX instead start with --profile nginx-lb and
# set OLLAMA_LB_HAPROXY_REPLICAS=0; both bind 127.0.0.1:11434 inside the gateway network namespace and cannot run together.

# ---------------------------------------------------------------------------------------------------------------------
# Pinned images (CONTRACT §1): name:tag@sha256:digest. scripts/lib/images.sh parses these *_IMAGE lines for air-gap bundles.
# ---------------------------------------------------------------------------------------------------------------------
FLUENT_BIT_IMAGE=fluent/fluent-bit:3.2.10-debug@sha256:ddc7932ed69e1e7bc34a62c57525c49f3947dc5fcee8b92256a33ae1836f3cda
FLUENT_BIT_DISTROLESS_IMAGE=fluent/fluent-bit:3.2.10@sha256:d6dec000c4929a439562525728c708f6e99800d7ddc82efd6aa4f45f3a20b562
FLUENTD_BASE_IMAGE=fluent/fluentd:v1.17-debian-1@sha256:d6114e87fb46d67fef988014cfeb9025df5d48984063dfde94c74cf4a1857440
OPENSEARCH_IMAGE=opensearchproject/opensearch:2.17.1@sha256:1193b7c29c5d63028523728243cc4da047ac49f697a8f8105e5aeee2f89bcc4c
DASHBOARDS_IMAGE=opensearchproject/opensearch-dashboards:2.17.1@sha256:dc12b6f576aae6024780c01b3cc81abdf611d34340371980ef8edc7738479b8f
PROMETHEUS_IMAGE=prom/prometheus:v2.55.1@sha256:2659f4c2ebb718e7695cb9b25ffa7d6be64db013daba13e05c875451cf51b0d3
ALERTMANAGER_IMAGE=prom/alertmanager:v0.27.0@sha256:e13b6ed5cb929eeaee733479dce55e10eb3bc2e9c4586c705a4e8da41e5eacf5
GRAFANA_IMAGE=grafana/grafana:10.4.19@sha256:a9043254ba16fb10945cc27333963dfd08eccbb43b51f1222d831cc564e3a1f4
HAPROXY_IMAGE=haproxy:3.0-alpine@sha256:d2b3567d836f3b7d174edb6d6f611ed5308e7966e53a9cd9a597e0415a298efd
NGINX_IMAGE=nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
OLLAMA_IMAGE=ollama/ollama:0.40.5@sha256:5d3a2f25f9825628daba94dc0b1d421c7d57d6c03ae5faa9ba050e058bab8241
DIND_IMAGE=docker:27-dind@sha256:aa3df78ecf320f5fafdce71c659f1629e96e9de0968305fe1de670e0ca9176ce
BUSYBOX_IMAGE=busybox:1.37@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec
CURL_IMAGE=curlimages/curl:8.10.1@sha256:d9b4541e214bcd85196d6e92e2753ac6d0ea699f0af5741f8c6cccbfcf00ef4b
VENDETTA_MANAGER_IMAGE=wazuh/wazuh-manager:4.9.2@sha256:b906ebfc77d78446e9b676e1a0b3cd78e2bf3ac2341688f1726b09c29e0aa826

# ---------------------------------------------------------------------------------------------------------------------
# Stack identity and posture
# ---------------------------------------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=vendetta-stack
STACK_VERSION=1.0.0
OLLAMA_PINNED_VERSION=0.40.5
LLAMA_CPP_PINNED_TAG=b4000
# cloud | onprem | airgap | edge. onprem and airgap are FailClosed: any cloud LLM credential or non-local mode aborts startup.
CS3_PROFILE=cloud
CS3_LLM_MODE=local
CS3_MESSAGE_MAX_CHARS=8000
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
# Group id that may read the 0640 keys and secrets written by `scripts/bootstrap.sh --key-group 10001` (services get it via group_add).
STACK_KEY_GID=10001
# Group that owns alerts.json in the vendetta-logs volume (the manager's `wazuh` group); Fluent Bit joins it to tail the alerts.
VENDETTA_LOGS_GID=999

# ---------------------------------------------------------------------------------------------------------------------
# Published ports. Every bind address defaults to loopback; set 0.0.0.0 only behind a firewall / reverse proxy.
# Ollama (11434) is never published: it lives in the gateway/worker network namespaces (CONTRACT §2).
# ---------------------------------------------------------------------------------------------------------------------
OPENSEARCH_BIND=127.0.0.1
OPENSEARCH_PORT=9200
DASHBOARDS_BIND=127.0.0.1
DASHBOARDS_PORT=5601
GRAFANA_BIND=127.0.0.1
GRAFANA_PORT=3001
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_PORT=9090
ALERTMANAGER_BIND=127.0.0.1
ALERTMANAGER_PORT=9093
FLUENT_BIND=127.0.0.1
FLUENT_BIT_FORWARD_PORT=24224
FLUENT_BIT_HTTP_PORT=9880
FLUENT_BIT_METRICS_PORT=2020
GATEWAY_BIND=127.0.0.1
GATEWAY_PUBLISH_PORT=9101
ERROW_VIEWER_BIND=127.0.0.1
ERROW_VIEWER_PUBLISH_PORT=8765
VENDETTA_BIND=127.0.0.1
VENDETTA_EVENTS_PORT=1514
VENDETTA_AUTHD_PORT=1515
VENDETTA_API_PORT=55000

# ---------------------------------------------------------------------------------------------------------------------
# OpenSearch (single node by default; opensearch.yml is the 3-node file for multi-host installs)
# vm.max_map_count must be >= 262144 on the Docker host: compose cannot set it (README "Host prerequisites").
# ---------------------------------------------------------------------------------------------------------------------
OPENSEARCH_CONFIG_FILE=opensearch.single-node.yml
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"
OPENSEARCH_MEM_LIMIT=1536m
OPENSEARCH_CLUSTER_NAME=vendetta-stack
OPENSEARCH_MEMORY_LOCK=true
OPENSEARCH_EXPECTED_NODES=1
OPENSEARCH_APPLY_REPLICAS=auto
OPENSEARCH_WAIT_TIMEOUT=300
OPENSEARCH_USER=admin
NODE_BOX_TYPE=hot
OPENSEARCH_URL=https://localhost:9200

# ---------------------------------------------------------------------------------------------------------------------
# Fluent Bit (edge collector) and the three delivery legs. Legs are disabled until configured; point them at the real
# Console / ESOC / SIEM, or at the test sink with --env-file .env.smoke. Leg credentials come from *_FILE paths only.
# ---------------------------------------------------------------------------------------------------------------------
FLB_LOG_LEVEL=info
FLB_FORWARD_TLS=on
FLB_FORWARD_TLS_VERIFY=on
FLB_FORWARD_STORAGE_LIMIT=2G
CS3_EPS_LIMIT=500
CS3_LEGS_DIR=./secrets/cs3-legs
ERROW_TUI_PORT=24225
# Optional manual Cfgaudit NDJSON ingestion. Create the host directory before enabling; see cfgaudit/README.md.
CFGAUDIT_ENABLED=false
CFGAUDIT_REPORTS_DIR=./data/cfgaudit
CS3_CONSOLE_ENABLED=false
CS3_HOST=localhost
CS3_PORT=443
CS3_TLS=On
CS3_ESOC_ENABLED=false
CS3_ESOC_HOST=localhost
CS3_ESOC_PORT=4317
CS3_ESOC_GRPC=On
CS3_ESOC_TLS=On
CS3_SIEM_ENABLED=false
CS3_SIEM_HOST=localhost
CS3_SIEM_PORT=443
CS3_SIEM_URI=/v1/events
CS3_SIEM_TLS=On
CS3_SIEM_FORMAT=json_lines
CS3_SIEM_AUTH_SCHEME=Bearer
# Manager integration leg. Needs BOTH CS3_HOST (alerts out to CS3) and CS3_MANAGER_HOST (host logs in through the
# manager's rule engine); requires CS3_INGEST_KEY_FILE as well. Leave false when running without the manager profile.
# On the manager side, CS3_MANAGER_STRICT=true aborts its boot when the ossec.conf patch fails, and
# CS3_MANAGER_CONF_TEMPLATE=/path/ossec.conf replaces the patch with a full configuration you own.
CS3_MANAGER_ENABLED=false
# Compose service name of the manager; set an external host when agents report to an existing manager instead.
CS3_MANAGER_HOST=vendetta-manager
CS3_MANAGER_PORT=5140
# How long a repeated (same rule, device and locator) manager alert is folded into the existing CS3 alert.
CS3_ALERT_DEDUP_WINDOW_S=300
# CTI / vulnerability feed updater in the manager. The stock image fetches from cti.wazuh.com every 60m; without egress that
# fails on every interval and logs a content-updater ERROR. off disables the updater, mirror points it at
# CS3_MANAGER_CTI_URL (an internal CTI mirror), auto leaves the image default and only logs what will happen.
CS3_MANAGER_FEED_MODE=off
CS3_MANAGER_CTI_URL=

# ---------------------------------------------------------------------------------------------------------------------
# Fluentd aggregators (fluentd-1, fluentd-2)
# ---------------------------------------------------------------------------------------------------------------------
FLUENTD_LOG_LEVEL=info
FLUENTD_WORKERS=1
FLUENTD_OS_BUFFER_LIMIT=2GB
LLM_TRIAGE_VENDETTA_SEVERITY_REGEX='^(medium|high|critical)$'
LLM_TRIAGE_ERROW_SEVERITY_REGEX='^$'
ERROW_FEEDBACK_SEVERITY_REGEX='^critical$'
VENDETTA_EXECD_AGENT_REGEX='^$'
ERROW_FEEDBACK_AR_COMMAND='!host-isolate.sh'
VENDETTA_API_USER=wazuh-wui

# ---------------------------------------------------------------------------------------------------------------------
# Inference tier: models, llm-gateway, Ollama workers (real: profile llm; mock: profile mock-llm)
# ---------------------------------------------------------------------------------------------------------------------
OLLAMA_BIND_ADDR=127.0.0.1:11434
# Stable contract for every client of the router: its base URL, the token (CS3_ROUTER_KEY may also be given inline) and
# the five role -> model bindings. Change a role here and every consumer follows; the OLLAMA_*/INFERENCE_* names below are
# deprecated aliases that still work but must not be reintroduced into new code.
CS3_ROUTER_URL=https://llm-gateway:9101
CS3_ROUTER_KEY=
CS3_MODEL_TRIAGE=nemotron-3-nano:30b
CS3_MODEL_REASONING=gemma4:26b
CS3_MODEL_REASONING_DEEP=gemma4:31b
CS3_MODEL_SECURITY=nemotron-3-nano:30b
CS3_MODEL_ERROW_SECURITY=cs3-errow-security
# Deprecated aliases (kept for older .env files; the router/entrypoint prefer CS3_MODEL_* above).
OLLAMA_PRIMARY_MODEL=nemotron-3-nano:30b
OLLAMA_FALLBACK_MODEL=gemma4:26b
OLLAMA_SECURITY_MODEL=nemotron-3-nano:30b
INFERENCE_MODEL_TRIAGE=nemotron-3-nano:30b
INFERENCE_MODEL_FORENSIC=gemma4:26b
INFERENCE_MODEL_SECURITY=nemotron-3-nano:30b
INFERENCE_MODEL_ERROW_SECURITY=nemotron-3-nano:30b
OLLAMA_REASONING_DEEP_MODEL=gemma4:31b
OLLAMA_ERROW_SECURITY_MODEL=nemotron-3-nano:30b
# Fixed production answer budgets. Only triage responses are cached.
INFERENCE_MAX_TOKENS_TRIAGE=1024
INFERENCE_MAX_TOKENS_SECURITY=2048
INFERENCE_MAX_TOKENS_ERROW=4096
GATEWAY_CACHE_TRIAGE=true
GATEWAY_CACHE_SECURITY=false
GATEWAY_CACHE_ERROW=false
# Per-role inference timeout (ms). The agentic security/Errow/deep roles get 120 s; 60 s times out mid-scan.
INFERENCE_TIMEOUT_MS=60000
INFERENCE_TIMEOUT_MS_SECURITY=120000
INFERENCE_TIMEOUT_MS_ERROW_SECURITY=120000
INFERENCE_TIMEOUT_MS_DEEP=120000
INFERENCE_MODEL_REASONING_DEEP=gemma4:31b
INFERENCE_MODEL_GUARD=gemma4:26b
INFERENCE_GPU_SHARE=1.0
GATEWAY_MTLS=optional
GATEWAY_MAX_CONCURRENCY=4
GATEWAY_MAX_QUEUE=512
GATEWAY_LOG_LEVEL=INFO
OLLAMA_LB_HAPROXY_REPLICAS=1
OLLAMA_LB_NGINX_REPLICAS=1
ENROLL_GATEWAY_URL=https://localhost:9101
MCP_LIVE=false
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_KEEP_ALIVE=30m
# Provision every production route, including the Gemma 31B security/Errow fallback. Qwensploit remains opt-in.
OLLAMA_PRELOAD_MODELS=nemotron-3-nano:30b,gemma4:26b,gemma4:31b
OLLAMA_PRELOAD_STRICT=true
OLLAMA_READY_TIMEOUT=120
OLLAMA_START_PERIOD=600s
OLLAMA_MEM_LIMIT=32g
# GPUs reserved for ollama-1 with docker-compose.gpu.yml: all, or a number.
OLLAMA_GPU_COUNT=all
OLLAMA_AIRGAP_BUNDLE_DIR=/bundle
OLLAMA_BUNDLE_HOST_DIR=./dist/bundle/ollama
MOCK_LATENCY_MS=0
MOCK_TOOL_TARGET=scan-target.vendetta.lab

# ---------------------------------------------------------------------------------------------------------------------
# Errow (profile errow) and its feedback loop. Live scans and live feedback actions are OFF until explicitly enabled.
# ---------------------------------------------------------------------------------------------------------------------
# Single source of truth for the Errow target allow-lists: comma list of host globs ("*.suffix" ok). ERROW_ALLOWED_TARGETS
# (errow entrypoint) and ERROW_FEEDBACK_ALLOWED_TARGETS (feedback loop) default from it; a non-empty per-service value wins.
# The errow-mcp/llm-gateway list is a yaml (MCP_TARGETS_FILE, additive over errow/mcp/policy.yaml) and must be extended by hand
# for real targets: scripts/check-allowlists.sh reports any drift between the three.
ERROW_TARGETS=scan-target.vendetta.lab
# ERROW_ALLOWED_TARGETS=
ERROW_SANDBOX_IMAGE=vendetta-stack/errow-sandbox:1.0.0
ERROW_BUNDLE_DIR=./dist/bundle/errow
ERROW_SANDBOX_IMAGE_TAR=/bundle/errow-sandbox.tar
ERROW_TELEMETRY=false
ERROW_CLOUD_ENABLED=false
ERROW_CLOUD_URL=https://app.errow.ai
ERROW_FEEDBACK_LIVE=false
ERROW_FEEDBACK_FORENSIC=true
# ERROW_FEEDBACK_ALLOWED_TARGETS=
ERROW_FEEDBACK_APPROVAL_DIR=./secrets/approval
# Per-approver signing keys live in $ERROW_FEEDBACK_APPROVAL_DIR/keys/<approver>.key (0600): approvals need
# ERROW_FEEDBACK_APPROVAL_THRESHOLD distinct authorities (default 2 = dual control). One shared key alone still works
# (the threshold clamps to 1) but gives no dual control. Generate with: approval.py keygen --approver <name>
# ERROW_FEEDBACK_APPROVAL_KEYS_DIR=/run/approval/keys
ERROW_FEEDBACK_APPROVAL_THRESHOLD=2
# The manager is verified against a pinned bundle and the gate fails closed (503) without it: live actions need
# scripts/pin-manager-cert.sh first. In Kubernetes, cert-manager owns the pin.
VENDETTA_API_CA_FILE=/pki/manager-ca-bundle.crt
MCP_ALLOWED_CLIENTS=llm-gateway,errow,errow-mcp
MCP_SANDBOX_NETWORK=offensive
MCP_TARGETS_DIR=./errow/config
ERROW_FEEDBACK_POLL_INTERVAL=60
SHIPPER_INTERVAL=10

# ---------------------------------------------------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------------------------------------------------
PROMETHEUS_RETENTION=15d
