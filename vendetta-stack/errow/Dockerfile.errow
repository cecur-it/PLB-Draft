# Dockerfile.errow - Errow orchestrator image (services `errow`, `errow-viewer`) -> vendetta-stack/errow:${STACK_VERSION}
# Traces: CONTRACT §0 (pinned bases, non-root, HEALTHCHECK), §2 (viewer 8765, errow-runs/errow-ndjson volumes), §4.4 (gateway-only LLM),
#         §8 (Errow addenda: local source install, TUI sidecar, DinD client), §11 (RUNTIME.md).
#
# Build context  = the UPSTREAM Errow tree (cecur-it-cs3-v1.1.0/errow, read-only for the stack);
# named context  = the stack's own assets (entrypoint, dind-ready helper, Go TUI bridge):
#
#   docker build \
#     -f vendetta-stack/errow/Dockerfile.errow \
#     --build-context stack=vendetta-stack/errow \
#     -t vendetta-stack/errow:1.0.0 \
#     cecur-it-cs3-v1.1.0/errow
#
# (Compose: build.context=../errow, build.dockerfile=../vendetta-stack/errow/Dockerfile.errow, build.additional_contexts: [stack=./errow].)
# The ignore file Dockerfile.errow.dockerignore (next to this file) keeps docs/tests/benchmarks out of the context.
#
# Build args:
#   VIEWER_SOURCE=prebuilt|built|external
#                                 prebuilt (default) ships the bundle committed under errow/interface/viewer/static;
#                                 built rebuilds it with node inside this build (needs the npm registry);
#                                 external ships viewer/dist/static from the stack context, made by viewer/frontend-build.sh
#                                 (which has an offline npm-cache mode for air-gapped build hosts).
#   ERROW_PIP_SPEC=<requirement>  install this spec (index/mirror/wheel URL) INSTEAD of the local source; skips the Go/hatch build.
#   PIP_INDEX_URL / GOPROXY       internal mirrors for restricted networks (air-gap: build elsewhere, `docker save`, `docker load`).
#   UV_VERSION                    uv used for the hash-locked install (uv.lock is `revision = 3`).
#
# Why the layout: the wheel build hook (scripts/tui_sidecar_hook.py) needs Go >= 1.24 and bakes errow/bin/errow-tui into a platform
# wheel, so Go lives only in the builder stage; the runtime must NOT have `go` on PATH (Errow would then `go run` the TUI from source).
# The stack's errow-tui bridge replaces errow/bin/errow-tui and keeps the original as errow-tui.real.

ARG PYTHON_IMAGE=python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
ARG GO_IMAGE=golang:1.24-bookworm@sha256:1a6d4452c65dea36aac2e2d606b01b4a029ec90cc1ae53890540ce6173ea77ac
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee
ARG DOCKER_CLI_IMAGE=docker:27-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c
ARG VIEWER_SOURCE=prebuilt

# ---------------------------------------------------------------- stage: Go TUI bridge (+ Go toolchain for the wheel hook)
FROM ${GO_IMAGE} AS go-bridge
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY} CGO_ENABLED=0 GOFLAGS=-mod=mod
WORKDIR /src
COPY --from=stack tui/bridge/go.mod ./
COPY --from=stack tui/bridge/*.go ./
RUN go vet ./... && go test -count=1 ./... \
 && go build -trimpath -ldflags='-s -w' -o /out/errow-tui-bridge .

# ---------------------------------------------------------------- stage: Docker CLI (Errow shells out to `docker` for the sandbox, never to the socket API)
FROM ${DOCKER_CLI_IMAGE} AS docker-cli

# ---------------------------------------------------------------- stage: viewer bundle (prebuilt | built)
FROM ${NODE_IMAGE} AS viewer-node
WORKDIR /frontend
COPY errow/interface/viewer/frontend/package.json errow/interface/viewer/frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY errow/interface/viewer/frontend/ ./
# vite.config.ts sets build.outDir to ../static, i.e. /static in this layout
RUN npm run build

FROM scratch AS viewer-built
COPY --from=viewer-node /static /static

FROM scratch AS viewer-prebuilt
COPY errow/interface/viewer/static /static

FROM scratch AS viewer-external
COPY --from=stack viewer/dist/static /static

FROM viewer-${VIEWER_SOURCE} AS viewer

# ---------------------------------------------------------------- stage: Python builder (hash-locked deps + wheel)
FROM ${PYTHON_IMAGE} AS builder
ARG UV_VERSION=0.13.8
ARG PIP_INDEX_URL
ARG GOPROXY=https://proxy.golang.org,direct
ARG ERROW_PIP_SPEC
ENV UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 UV_PROJECT_ENVIRONMENT=/opt/errow \
    PIP_DISABLE_PIP_VERSION_CHECK=1 GOPROXY=${GOPROXY} CGO_ENABLED=0 PATH=/usr/local/go/bin:${PATH} \
    errow_NO_UPDATE_CHECK=1 errow_TELEMETRY=false
COPY --from=go-bridge /usr/local/go /usr/local/go
RUN --mount=type=cache,target=/root/.cache/pip pip install "uv==${UV_VERSION}"
WORKDIR /src
COPY pyproject.toml uv.lock README.md LICENSE.md ./
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ -n "${PIP_INDEX_URL}" ]; then export UV_INDEX_URL="${PIP_INDEX_URL}" UV_DEFAULT_INDEX="${PIP_INDEX_URL}"; fi; \
    if [ -z "${ERROW_PIP_SPEC}" ]; then uv sync --frozen --no-dev --no-install-project; else uv venv /opt/errow; fi
COPY errow ./errow
COPY scripts/tui_sidecar_hook.py ./scripts/tui_sidecar_hook.py
COPY --from=viewer /static ./errow/interface/viewer/static
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ -n "${PIP_INDEX_URL}" ]; then export UV_INDEX_URL="${PIP_INDEX_URL}" UV_DEFAULT_INDEX="${PIP_INDEX_URL}"; fi; \
    if [ -z "${ERROW_PIP_SPEC}" ]; then \
      uv build --wheel --out-dir /dist . && uv pip install --python /opt/errow/bin/python --no-deps /dist/*.whl; \
    else \
      uv pip install --python /opt/errow/bin/python "${ERROW_PIP_SPEC}"; \
    fi
COPY --from=go-bridge /out/errow-tui-bridge /out/errow-tui-bridge
RUN set -eux; \
    tui=/opt/errow/lib/python3.12/site-packages/errow/bin/errow-tui; \
    if [ -x "${tui}" ]; then mv "${tui}" "${tui}.real" && install -m 0755 /out/errow-tui-bridge "${tui}"; \
    else echo "no bundled errow-tui in this install; the TUI bridge is not installed (non-interactive scans are unaffected)"; fi; \
    /opt/errow/bin/errow --help >/dev/null

# ---------------------------------------------------------------- stage: runtime
FROM ${PYTHON_IMAGE} AS runtime
ARG STACK_VERSION=1.0.0
LABEL org.opencontainers.image.title="vendetta-stack/errow" \
      org.opencontainers.image.description="Errow orchestrator (one-shot scan CLI + viewer) wired to the sovereign LLM gateway" \
      org.opencontainers.image.version="${STACK_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0"
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/errow/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    HOME=/home/errow STACK_VERSION=${STACK_VERSION} \
    ERROW_WORKDIR=/workspace ERROW_LOG_DIR=/var/log/errow ERROW_PYTHON=/opt/errow/bin/python \
    ERROW_BIN=/usr/local/bin/errow-entrypoint ERROW_VIEWER_PORT=8765 \
    errow_NO_UPDATE_CHECK=1 errow_TELEMETRY=false
RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates curl git jq tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 errow \
 && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/errow --shell /usr/sbin/nologin errow \
 && install -d -m 0755 /etc/errow /usr/local/lib/errow-stack \
 && install -d -o errow -g errow -m 0755 /workspace /var/log/errow \
 && install -d -o errow -g errow -m 0700 /home/errow/.errow
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=builder /opt/errow /opt/errow
COPY --from=stack --chmod=0755 entrypoint.sh /usr/local/lib/errow-stack/entrypoint.sh
COPY --from=stack --chmod=0755 dind-ready.py /usr/local/lib/errow-stack/dind-ready.py
COPY --from=stack --chmod=0755 stack-config.py /usr/local/lib/errow-stack/stack-config.py
COPY --from=stack --chmod=0644 config/errow-config.yaml /etc/errow/errow-config.yaml
COPY --from=stack --chmod=0644 config/llm-providers.yaml /etc/errow/llm-providers.yaml
RUN ln -s /usr/local/lib/errow-stack/entrypoint.sh /usr/local/bin/errow-entrypoint
USER 10001:10001
WORKDIR /workspace
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=15s --start-period=90s --retries=3 CMD ["/usr/local/bin/errow-entrypoint", "--healthcheck"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/errow-entrypoint"]
CMD []
