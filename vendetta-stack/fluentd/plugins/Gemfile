# Traces: PROMPT §1 Tier 2 (Fluentd aggregation), CONTRACT §5 (gems) and §8.13 (Dockerfile)
# Exact pins, resolved against fluentd 1.17.1 / ruby 3.2 (fluent/fluentd:v1.17-debian-1). Gemfile.lock pins the
# transitive closure; refresh both together with:  tests/validate.sh --relock
# Core out_http / out_forward / in_forward / filter_grep / filter_record_transformer ship with fluentd itself.
# fluent-plugin-opentelemetry is NOT installed: it needs the native `grpc` gem (compiler toolchain, ~100 MB) and the
# ESOC leg is therefore OTLP/HTTP-JSON through plugins/out_otlp_http.rb (a subclass of core out_http).
source 'https://rubygems.org'

gem 'fluentd', '1.17.1'
gem 'fluent-plugin-opensearch', '1.1.5'
gem 'fluent-plugin-prometheus', '2.2.0'
gem 'fluent-plugin-record-modifier', '2.2.0'
gem 'fluent-plugin-rewrite-tag-filter', '2.4.0'

# The base image has no compiler: keep every native extension on the version already shipped in the image so
# `bundle install` never has to build one.
gem 'bigdecimal', '3.1.3'
gem 'cool.io', '1.9.0'
gem 'http_parser.rb', '0.8.0'
gem 'json', '2.7.4'
