{
  "index_patterns": ["cs3-ai-audit-*"],
  "priority": 200,
  "version": 1,
  "_meta": {
    "description": "Hash-chained AI audit trail (NIST SP 800-53 AU-9): every cs3.ai.inference and cs3.ai.tool_call event from the LLM gateway, with chain_id/seq/prev_hash/hash (hash = sha256(prev_hash + canonical_json(event without hash))). IMMUTABLE BY INTENT: documents are append-only and must never be updated or deleted. Writers SHOULD index with op_type=create and _id=<hash> so a replayed event is rejected rather than overwritten. The write block is applied by the cs3-ai-audit-retention ISM policy after 1 day (not here: index.blocks.write in a template would reject the first write); retention is 7 years with a snapshot to repository vendetta-snapshots before delete. Fields are mapped explicitly and unknown fields are kept in _source only (dynamic=false) so the audit schema cannot be widened by a writer.",
    "immutable": true,
    "retention_policy": "cs3-ai-audit-retention",
    "snapshot_repository": "vendetta-snapshots",
    "managed_by": "vendetta-stack/opensearch/apply.sh"
  },
  "template": {
    "settings": {
      "index.number_of_shards": 1,
      "index.number_of_replicas": 1,
      "index.refresh_interval": "5s",
      "index.codec": "best_compression",
      "index.routing.allocation.require.box_type": "hot",
      "index.mapping.total_fields.limit": 500,
      "index.mapping.ignore_malformed": true
    },
    "mappings": {
      "dynamic": false,
      "date_detection": false,
      "numeric_detection": false,
      "properties": {
        "@timestamp": { "type": "date" },
        "event_type": { "type": "keyword" },
        "request_id": { "type": "keyword" },
        "tenant_id": { "type": "keyword" },
        "incident_id": { "type": "keyword" },
        "alert_id": { "type": "keyword" },
        "role": { "type": "keyword" },
        "model": { "type": "keyword" },
        "engine_used": { "type": "keyword" },
        "fallback": { "type": "boolean" },
        "fallback_reason": { "type": "keyword" },
        "latency_ms": { "type": "double" },
        "gpu_seconds": { "type": "double" },
        "tokens_in": { "type": "long" },
        "tokens_out": { "type": "long" },
        "verdict": { "type": "keyword" },
        "guardrail": {
          "properties": {
            "passed": { "type": "boolean" },
            "violations": { "type": "keyword" }
          }
        },
        "input_sha256": { "type": "keyword" },
        "input_chars": { "type": "long" },
        "analysis": {
          "properties": {
            "triageSummary": { "type": "text", "norms": false },
            "severityAssessment": { "type": "keyword" },
            "mitreTactic": { "type": "keyword" },
            "mitreTechnique": { "type": "keyword" },
            "engineUsed": { "type": "keyword" },
            "confidenceScore": { "type": "float" },
            "needsVerification": { "type": "boolean" },
            "gpuSeconds": { "type": "double" }
          }
        },
        "tool": { "type": "keyword" },
        "args": { "type": "flat_object" },
        "target": { "type": "keyword", "ignore_above": 1024 },
        "decision": { "type": "keyword" },
        "violations": { "type": "keyword" },
        "rationale": { "type": "text", "norms": false },
        "live": { "type": "boolean" },
        "result_summary": { "type": "text", "norms": false },
        "chain_id": { "type": "keyword" },
        "seq": { "type": "long" },
        "prev_hash": { "type": "keyword" },
        "hash": { "type": "keyword" }
      }
    }
  }
}
