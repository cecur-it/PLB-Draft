{
  "index_patterns": ["errow-transcripts-*"],
  "priority": 200,
  "version": 1,
  "_meta": {
    "description": "Errow agent transcripts: one record per agent message (role, agent, content truncated to 8000 chars and redacted at the edge). Content is full-text searchable; the index is not mapped for aggregation on content.",
    "managed_by": "vendetta-stack/opensearch/apply.sh"
  },
  "template": {
    "settings": {
      "index.number_of_shards": 1,
      "index.number_of_replicas": 1,
      "index.refresh_interval": "10s",
      "index.codec": "best_compression",
      "index.routing.allocation.require.box_type": "hot",
      "index.mapping.total_fields.limit": 1000,
      "index.mapping.ignore_malformed": true
    },
    "mappings": {
      "dynamic": true,
      "date_detection": false,
      "numeric_detection": false,
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "stream": { "type": "keyword" },
        "run": { "type": "keyword" },
        "source": { "type": "keyword" },
        "doc_id": { "type": "keyword" },
        "role": { "type": "keyword" },
        "agent": { "type": "keyword" },
        "agent_id": { "type": "keyword" },
        "agent_name": { "type": "keyword" },
        "timestamp": { "type": "date" },
        "content": { "type": "text" },
        "tool_calls": { "type": "object", "enabled": false },
        "ingest_error": {
          "type": "text",
          "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } }
        }
      }
    }
  }
}
