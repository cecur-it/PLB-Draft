# Generated by scripts/bootstrap.sh — never commit secrets or private keys
/secrets/
/pki/
/pki-archive/
/.env
!.env.example
!.env.smoke

# Test fixtures that the repository-level *.log rule would otherwise drop
!errow/shipper/tests/fixtures/**/errow.log

# Smoke-test output and local Cfgaudit reports (may contain sensitive evidence)
/tests/results/
/tests/.smoke-data/
/data/cfgaudit/

# Local build / scratch artifacts
.venv*/
**/.venv*/
**/.scratch/
**/__pycache__/
**/*.pyc
.pytest_cache/
**/.pytest-tmp/
**/*.egg-info/
build/
dist/
*.sbom.json
SHA256SUMS
