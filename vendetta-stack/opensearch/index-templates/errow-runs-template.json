{
  "index_patterns": ["errow-runs-*"],
  "priority": 200,
  "version": 1,
  "_meta": {
    "description": "Errow run records: run.json content plus the shipper stream fields (CONTRACT s15). The shipper re-emits a record whenever the rewritten run.json content hash changes, so one run id can appear several times with growing status/llm_usage.",
    "managed_by": "vendetta-stack/opensearch/apply.sh"
  },
  "template": {
    "settings": {
      "index.number_of_shards": 1,
      "index.number_of_replicas": 1,
      "index.refresh_interval": "10s",
      "index.codec": "best_compression",
      "index.routing.allocation.require.box_type": "hot",
      "index.mapping.total_fields.limit": 2000,
      "index.mapping.ignore_malformed": true
    },
    "mappings": {
      "dynamic": true,
      "date_detection": false,
      "numeric_detection": false,
      "dynamic_templates": [
        {
          "strings_as_keyword": {
            "match_mapping_type": "string",
            "mapping": { "type": "keyword", "ignore_above": 1024 }
          }
        }
      ],
      "properties": {
        "@timestamp": { "type": "date" },
        "stream": { "type": "keyword" },
        "run": { "type": "keyword" },
        "source": { "type": "keyword" },
        "run_id": { "type": "keyword" },
        "run_name": { "type": "keyword" },
        "status": { "type": "keyword" },
        "start_time": { "type": "date" },
        "end_time": { "type": "date" },
        "auth_mode": { "type": "keyword" },
        "scan_mode": { "type": "keyword" },
        "scope_mode": { "type": "keyword" },
        "non_interactive": { "type": "boolean" },
        "instruction": { "type": "text", "norms": false },
        "user_instruction": { "type": "text", "norms": false },
        "targets_info": {
          "properties": {
            "type": { "type": "keyword" },
            "original": { "type": "keyword", "ignore_above": 1024 },
            "details": {
              "properties": {
                "target_url": { "type": "keyword", "ignore_above": 1024 }
              }
            }
          }
        },
        "diff_scope": {
          "properties": {
            "active": { "type": "boolean" }
          }
        },
        "llm_usage": {
          "properties": {
            "requests": { "type": "long" },
            "input_tokens": { "type": "long" },
            "output_tokens": { "type": "long" },
            "total_tokens": { "type": "long" },
            "cost": { "type": "double" },
            "input_tokens_details": { "type": "object", "enabled": false },
            "output_tokens_details": { "type": "object", "enabled": false },
            "request_usage_entries": { "type": "object", "enabled": false },
            "providers": { "type": "object", "dynamic": true },
            "agents": {
              "properties": {
                "agent_id": { "type": "keyword" },
                "agent_name": { "type": "keyword" },
                "model": { "type": "keyword" },
                "requests": { "type": "long" },
                "input_tokens": { "type": "long" },
                "output_tokens": { "type": "long" },
                "total_tokens": { "type": "long" },
                "cost": { "type": "double" },
                "input_tokens_details": { "type": "object", "enabled": false },
                "output_tokens_details": { "type": "object", "enabled": false },
                "request_usage_entries": { "type": "object", "enabled": false }
              }
            }
          }
        },
        "scan_results": {
          "properties": {
            "scan_completed": { "type": "boolean" },
            "success": { "type": "boolean" },
            "executive_summary": { "type": "text", "norms": false },
            "methodology": { "type": "text", "norms": false },
            "technical_analysis": { "type": "text", "norms": false },
            "recommendations": { "type": "text", "norms": false }
          }
        },
        "ingest_error": {
          "type": "text",
          "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } }
        }
      }
    }
  }
}
