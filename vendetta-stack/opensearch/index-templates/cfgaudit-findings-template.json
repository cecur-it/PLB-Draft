{
  "index_patterns": ["cfgaudit-findings-*"],
  "priority": 200,
  "version": 1,
  "_meta": {
    "description": "Cfgaudit network configuration findings. Dedicated schema; not SARIF and not a Vendetta alert. Deterministic finding ids make replayed assessments idempotent.",
    "managed_by": "vendetta-stack/opensearch/apply.sh"
  },
  "template": {
    "settings": {
      "index.number_of_shards": 1,
      "index.number_of_replicas": 1,
      "index.refresh_interval": "10s",
      "index.codec": "best_compression",
      "index.routing.allocation.require.box_type": "hot",
      "index.mapping.total_fields.limit": 1000,
      "index.mapping.ignore_malformed": false
    },
    "mappings": {
      "dynamic": false,
      "date_detection": false,
      "numeric_detection": false,
      "properties": {
        "schema_version": { "type": "keyword" },
        "record_type": { "type": "keyword" },
        "@timestamp": { "type": "date" },
        "doc_id": { "type": "keyword" },
        "source": {
          "properties": {
            "system": { "type": "keyword" },
            "stream": { "type": "keyword" }
          }
        },
        "run": {
          "properties": { "id": { "type": "keyword" } }
        },
        "asset": {
          "properties": {
            "id": { "type": "keyword" },
            "name": { "type": "keyword", "ignore_above": 1024 },
            "vendor": { "type": "keyword" }
          }
        },
        "config": {
          "properties": {
            "name": { "type": "keyword", "ignore_above": 1024 },
            "sha256": { "type": "keyword" }
          }
        },
        "control": {
          "properties": {
            "id": { "type": "keyword" },
            "title": { "type": "text", "norms": false },
            "frameworks": {
              "type": "nested",
              "properties": {
                "name": { "type": "keyword" },
                "reference": { "type": "keyword" },
                "mapping": { "type": "keyword" }
              }
            }
          }
        },
        "finding": {
          "properties": {
            "id": { "type": "keyword" },
            "key": { "type": "keyword" }
          }
        },
        "status": { "type": "keyword" },
        "severity": { "type": "keyword" },
        "evidence": {
          "properties": {
            "sha256": { "type": "keyword" },
            "items": { "type": "text", "norms": false }
          }
        },
        "remediation": { "type": "text", "norms": false }
      }
    }
  }
}
