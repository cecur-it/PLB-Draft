{
  "description": "Errow finding enrichment: derives cwe, OWASP Top 10:2021 category (owasp), MITRE ATT&CK mapping (mitre.id / mitre.technique / mitre.tactic) and a normalised severity from a raw SARIF-result record shipped by errow-shipper (CONTRACT s15). CWE comes from properties.errow.cwe, else ruleId (CWE-n), else rule.properties.tags. The ATT&CK mapping is a curated CWE-to-technique approximation for triage, not an official MITRE mapping. Unknown CWEs are left unmapped. Nothing is removed from the record.",
  "processors": [
    {
      "script": {
        "description": "CWE -> OWASP/ATT&CK lookup; all derived fields are assigned at the end so a failure leaves the record untouched.",
        "lang": "painless",
        "source": "int cweNum(def v) {\n  if (v == null) { return -1; }\n  String s = v.toString().trim().toUpperCase();\n  int i = s.indexOf('CWE');\n  boolean tagged = i >= 0;\n  i = tagged ? i + 3 : 0;\n  while (i < s.length() && '-_: '.indexOf(s.substring(i, i + 1)) >= 0) { i++; }\n  int j = i;\n  while (j < s.length() && '0123456789'.indexOf(s.substring(j, j + 1)) >= 0) { j++; }\n  if (j == i || j - i > 5) { return -1; }\n  if (!tagged && j != s.length()) { return -1; }\n  return Integer.parseInt(s.substring(i, j));\n}\nString sevNorm(def v) {\n  if (v == null) { return null; }\n  String s = v.toString().trim().toLowerCase();\n  if (s == 'informational' || s == 'information' || s == 'none') { return 'info'; }\n  if (s == 'moderate' || s == 'med') { return 'medium'; }\n  if (s == 'critical' || s == 'high' || s == 'medium' || s == 'low' || s == 'info') { return s; }\n  return null;\n}\nMap props = ctx['properties'] instanceof Map ? (Map) ctx['properties'] : new HashMap();\nMap err = props['errow'] instanceof Map ? (Map) props['errow'] : new HashMap();\nint cwe = cweNum(err['cwe']);\nif (cwe < 0) { cwe = cweNum(ctx['ruleId']); }\nif (cwe < 0 && ctx['rule'] instanceof Map && ((Map) ctx['rule'])['properties'] instanceof Map) {\n  Map rp = (Map) ((Map) ctx['rule'])['properties'];\n  if (rp['tags'] instanceof List) {\n    for (def t : rp['tags']) { if (cwe < 0) { cwe = cweNum(t); } }\n  }\n}\nString sev = sevNorm(err['severity']);\nif (sev == null && ctx['level'] != null) {\n  String lv = ctx['level'].toString().toLowerCase();\n  sev = lv == 'error' ? 'high' : (lv == 'warning' ? 'medium' : (lv == 'note' ? 'low' : (lv == 'none' ? 'info' : null)));\n}\nString owasp = null;\nList ids = new ArrayList();\nList techs = new ArrayList();\nLinkedHashSet tacs = new LinkedHashSet();\nif (cwe >= 0) {\n  for (def e : params['owasp'].entrySet()) {\n    if (owasp == null && e.getValue().contains(cwe)) { owasp = e.getKey(); }\n  }\n  def tl = params['attack'][String.valueOf(cwe)];\n  if (tl != null) {\n    for (def id : tl) {\n      def spec = params['techniques'][id];\n      ids.add(id);\n      techs.add(spec[0]);\n      for (String t : spec[1].splitOnToken(',')) { tacs.add(t); }\n    }\n  }\n}\nif (cwe >= 0) { ctx['cwe'] = 'CWE-' + cwe; }\nif (owasp != null) { ctx['owasp'] = owasp; }\nif (sev != null) { ctx['severity'] = sev; }\nif (!ids.isEmpty()) {\n  Map m = new HashMap();\n  m['id'] = ids;\n  m['technique'] = techs;\n  m['tactic'] = new ArrayList(tacs);\n  ctx['mitre'] = m;\n}",
        "params": {
          "owasp": {
