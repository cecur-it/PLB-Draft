# Cecur CS3 forwarder — /etc/cecur/forwarder.env (mode 0600, root-owned). REFERENCE ONLY.
#
# install-forwarder.sh writes and maintains this file; do not copy this example over a live one.
# It documents every variable the Fluent Bit templates read (${NAME} in fluent-bit-linux.conf and
# gateway.d/*.conf, plus CS3_MESSAGE_MAX_CHARS read by cs3-otlp-normalize.lua) so the file can be
# reviewed, templated by config management, or hand-tuned. After editing a live file:
#   systemctl restart cecur-forwarder
# Fluent Bit has no ${VAR:-default}: every variable a rendered fragment references MUST be set.
# Re-running the installer regenerates the gateway block; the three tuning knobs in section 3 survive.
# Full guide: deployment/operations/fluent-telemetry-fabric.md

# ---- 1. Console link (both profiles; written at enrollment) --------------------------------------
CS3_HOST=console.example.internal         # CS3 console host (POST /api/cecur/logs/ingest)
CS3_PORT=443                              # console port
CS3_AGENT_ID=cecur-ag-0123456789ab        # issued at enrollment; also the agent_id OTLP label / X-CS3-Agent
CS3_HOSTNAME=sensor-01.example.internal   # stamped on every record as agentName
CS3_INGEST_KEY=REPLACE_WITH_ENROLLED_KEY  # X-API-Key; never commit, never pass on argv
CS3_CA_FILE=/etc/cecur/pki/ca.pem         # trust anchor for the console (system store when none supplied)
# CS3_PIN_SHA256=<base64 SPKI hash>       # optional pin recorded at enrollment (curl --pinnedpubkey); not read by Fluent Bit

# ---- 2. Local OTLP listener (--profile gateway) --------------------------------------------------
# One port serves OTLP/HTTP and OTLP/gRPC. Off-loopback requires mTLS (the installer enforces it).
CS3_OTLP_LISTEN=127.0.0.1                 # loopback = plaintext fragment; anything else = mTLS fragment
CS3_OTLP_PORT=4318                        # 1-65535
# Set only with mTLS (--otlp-cert/--otlp-key/--otlp-client-ca); clients must present a cert from this CA:
# CS3_OTLP_CA_FILE=/etc/cecur/pki/otlp-client-ca.pem
# CS3_OTLP_CERT_FILE=/etc/cecur/pki/otlp-server.crt
# CS3_OTLP_KEY_FILE=/etc/cecur/pki/otlp-server.key

# ---- 3. Tuning (survives installer re-runs) ------------------------------------------------------
CS3_HEARTBEAT_SEC=60                      # host.heartbeat cadence; each delivery refreshes the agent's lastKeepAlive, so alert on its age
CS3_HEALTH_SCRAPE_SEC=30                  # Fluent Bit self-metrics scrape -> cs3.health.metrics (ESOC leg only)
CS3_MESSAGE_MAX_CHARS=8000                # edge truncation; matches the server's sanitizeUntrusted() cap

# ---- 4. ESOC leg: OTLP/gRPC + mTLS TLS 1.3 (--esoc-host ...) -------------------------------------
# CS3_ESOC_HOST=esoc-gateway.example.internal
# CS3_ESOC_PORT=4317
# CS3_ESOC_CA_FILE=/etc/cecur/pki/esoc-ca.pem      # or /etc/ssl/certs/ca-certificates.crt
# CS3_ESOC_CERT_FILE=/etc/cecur/pki/esoc-client.crt
# CS3_ESOC_KEY_FILE=/etc/cecur/pki/esoc-client.key

# ---- 5. Customer SIEM leg: HTTPS (--siem-url ...) ------------------------------------------------
# CS3_SIEM_HOST=siem.example.internal
# CS3_SIEM_PORT=443
# CS3_SIEM_URI='/v1/events'                         # single-quoted: may contain ? & =
# CS3_SIEM_TLS=On                                   # the installer only accepts https
# CS3_SIEM_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# CS3_SIEM_FORMAT=json_lines                        # json_lines (NDJSON) | json | json_stream
# CS3_SIEM_AUTH_SCHEME=Bearer                       # "Authorization: <scheme> <token>"
# CS3_SIEM_TOKEN=REPLACE_WITH_SIEM_TOKEN            # via CS3_SIEM_TOKEN env or --siem-token-file only
# CS3_SIEM_PROXY='http://proxy.example.internal:3128'   # optional egress proxy (CONNECT)
