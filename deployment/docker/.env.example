# CS3 Docker/Podman Compose environment. Copy to .env (gitignored) and fill in.
# Generate secrets with:  openssl rand -hex 32
CS3_PROFILE=onprem                 # cloud | onprem | airgap
CS3_CONSOLE_IMAGE=cs3-soc-console:1.1.0
CS3_CONSOLE_BIND=127.0.0.1
CS3_CONSOLE_PORT=3000
# Exactly one known NGINX proxy hop; use 0 only for direct local development.
CS3_TRUST_PROXY_HOPS=1
APP_URL=https://soc.example.internal

JWT_SECRET=
# First admin account; rotate after first login. The on-prem preparation script generates this when blank.
CS3_BOOTSTRAP_ADMIN_PASSWORD=
CS3_INGEST_REQUIRE_KEY=true        # enforce per-agent X-API-Key on /api/cecur/logs/ingest

# --- PostgreSQL (JSONB persistence) ---
POSTGRES_DB=cs3
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
CS3_APP_PASSWORD=
CS3_MIGRATOR_PASSWORD=
CS3_ARCHIVER_PASSWORD=

# --- Ollama (multi-node behind NGINX) ---
OLLAMA_IMAGE=ollama/ollama:0.40.5
OLLAMA_PRIMARY_MODEL=nemotron-3-nano:30b
OLLAMA_FALLBACK_MODEL=gemma4:26b
OLLAMA_SECURITY_MODEL=nemotron-3-nano:30b
OLLAMA_REASONING_DEEP_MODEL=gemma4:31b
OLLAMA_ERROW_SECURITY_MODEL=nemotron-3-nano:30b
INFERENCE_MODEL_TRIAGE=nemotron-3-nano:30b
INFERENCE_MODEL_FORENSIC=gemma4:26b
INFERENCE_MODEL_REASONING_DEEP=gemma4:31b
INFERENCE_MODEL_SECURITY=nemotron-3-nano:30b
INFERENCE_MODEL_ERROW_SECURITY=nemotron-3-nano:30b
INFERENCE_MODEL_GUARD=gemma4:26b
INFERENCE_MAX_TOKENS_TRIAGE=1024
INFERENCE_MAX_TOKENS_SECURITY=2048
INFERENCE_MAX_TOKENS_ERROW=4096
OLLAMA_PRELOAD_MODELS=nemotron-3-nano:30b,gemma4:26b,gemma4:31b
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_KEEP_ALIVE=30m
# Total inference deadline, including retries. Keep below the outer HTTPS proxy timeout.
INFERENCE_TIMEOUT_MS=60000
# Durable remediation only: one queued worker, no backend retries, maximum 4096 completion tokens.
# The Ollama completion proxy allows 65 minutes; synchronous routes retain INFERENCE_TIMEOUT_MS.
INFERENCE_REMEDIATION_TIMEOUT_MS=3600000
# Structured Ollama answers skip hidden reasoning by default; set a model-supported effort to override.
INFERENCE_REASONING_EFFORT=none

# --- Optional remote Errow task connector ---
# Blank ERROW_BASE_URL leaves scans unconfigured; Ollama does not provide the Errow /api/tasks contract.
# A root-env loopback URL is not imported because loopback inside the console is the container itself.
ERROW_BASE_URL=
ERROW_API_KEY=
ERROW_MODE=embedded
ERROW_SANDBOX_RUNTIME=docker

# --- Asset inventory ---
# PLB_ASSETS_CSV_HOST=../../PLB_Assets.csv   # asset inventory mounted into the console

# --- SIEM indexer (profile "siem") ---
CECUR_INDEXER_URL=https://indexer:9200
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
OPENSEARCH_INITIAL_ADMIN_PASSWORD=

# Durable log indexing in the console: set "true" only when running with
# `--profile siem` (see docker/README.md). CECUR_INDEXER_PASSWORD should match
# OPENSEARCH_INITIAL_ADMIN_PASSWORD above.
CS3_INDEXER_ENABLED=false
CECUR_INDEXER_USERNAME=admin
CECUR_INDEXER_PASSWORD=
CECUR_INDEXER_TLS_INSECURE=false

# --- Audit ledger ---
# Fail critical actions (503) when the audit ledger cannot be written.
CS3_AUDIT_STRICT=true
CS3_AUDIT_PERSIST_TIMEOUT_MS=2000
CS3_AUDIT_QUEUE_MAX=5000
CS3_AUDIT_BACKLOG_ALERT=50
CS3_AUDIT_VERIFY_INTERVAL_MS=300000
# Checkpoint signing key for scripts/audit-checkpoint.mjs (mint with --keygen).
CS3_AUDIT_CHECKPOINT_KEY=
